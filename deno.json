{
	"name": "@thefridge/skyr",
	"version": "0.2.0",
	"exports": "./mod.ts",
	"publish": {
		"exclude": [
			"scripts/",
			"coverage/",
			"**/*_test.ts",
			"bench.ts",
			"version.txt",
			".github/"
		]
	},
	"imports": {
		"@std/assert": "jsr:@std/assert@^1.0.19",
		"@std/testing": "jsr:@std/testing@^1.0.17"
	},
	"fmt": {
		"useTabs": true,
		"lineWidth": 80,
		"semiColons": true,
		"exclude": ["CHANGELOG.md"]
	},
	"lint": {
		"rules": {
			"exclude": ["no-explicit-any"]
		}
	}
}
