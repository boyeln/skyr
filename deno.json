{
	"name": "@boyeln/skyr",
	"version": "1.0.0",
	"exports": "./mod.ts",
	"publish": {
		"exclude": [
			"scripts/",
			"dist/",
			"coverage/",
			"**/*_test.ts",
			"bench.ts",
			"version.txt",
			".github/"
		]
	},
	"imports": {
		"@std/assert": "jsr:@std/assert@^1.0.19",
		"@std/testing": "jsr:@std/testing@^1.0.17",
		"@deno/dnt": "jsr:@deno/dnt@^0.42.3"
	},
	"tasks": {
		"test": "deno test --allow-all",
		"test:coverage": "deno test --allow-all --coverage=coverage",
		"bench": "deno bench --allow-all",
		"lint": "deno lint",
		"fmt": "deno fmt",
		"fmt:check": "deno fmt --check",
		"check": "deno check **/*.ts",
		"build:npm": "deno run -A scripts/build_npm.ts"
	},
	"fmt": {
		"useTabs": true,
		"lineWidth": 80,
		"semiColons": true,
		"exclude": ["CHANGELOG.md"]
	},
	"lint": {
		"rules": {
			"exclude": [
				"no-explicit-any"
			]
		}
	}
}
